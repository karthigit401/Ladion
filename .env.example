# Supabase project (Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key - server-side ONLY, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo mode: when "demo", payments/email/whatsapp are fully simulated locally.
# Set to "live" later once Razorpay/Resend/WhatsApp Cloud API are wired up.
APP_MODE=demo

# Base URL of this app (used to build absolute links in simulated notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign/verify the simulated payment webhook (HMAC-SHA256).
# Replace with your real provider's webhook secret when going live.
PAYMENT_WEBHOOK_SECRET=ladion-demo-webhook-secret
